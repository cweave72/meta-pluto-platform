# Local build host settings. Do not put hardware or policy settings here.

MACHINE ??= "pluto"
DISTRO ?= "pluto"

# Build caches. init_build.sh replaces these three lines.
# DL_DIR and SSTATE_DIR can be on a network share. TMPDIR must be on a local disk.
# Use "=", not "?=". bitbake.conf sets TMPDIR with "?=" before it reads
# local.conf, so "?=" here has no effect.
DL_DIR = "${TOPDIR}/downloads"
SSTATE_DIR = "${TOPDIR}/sstate-cache"
TMPDIR = "${TOPDIR}/tmp"

# Build output: images, packages, and license data. Keep it in the build
# directory. TMPDIR keeps only the work directories and sysroots.
DEPLOY_DIR = "${TOPDIR}/deploy"

# Hash equivalence database. One local directory for all build directories on
# this host. Do not put it on a network share (SQLite locks).
BB_HASHSERVE_DB_DIR ?= "${HOME}/yocto/hashserv"

# Remove each work directory after a successful build. TMPDIR stays small.
INHERIT += "rm_work"
# Keep the image work directory. The assembled root file system stays in
# ${TMPDIR}/work/${MACHINE}-poky-linux-gnueabi/<image>/1.0/rootfs/.
RM_WORK_EXCLUDE += "core-image-minimal"
# Keep the work directory of a recipe that you debug:
#RM_WORK_EXCLUDE += "linux-pluto"

# Write each git mirror in DL_DIR as one tarball. Faster on a network share.
BB_GENERATE_MIRROR_TARBALLS = "1"

# Platform default bitstream (.bit) for the FIT image.
# Empty: pluto-fit uses the ADI stock system_top.bit (pluto-jtag-bootstrap).
# Example: PLUTO_BITSTREAM = "/home/<user>/pluto/system_top.bit"
PLUTO_BITSTREAM ?= ""

# Development only: root login on the serial console without a password.
# Remove these features for a release image.
EXTRA_IMAGE_FEATURES ?= "allow-empty-password empty-root-password allow-root-login"

# Build host load limits. Set for a 12-CPU, 12 GB host. BitBake defaults
# to one task per CPU and "make -j <CPUs>" in each task. On a host with less
# than about 2 GB RAM per CPU, the defaults fill the RAM and the host swaps.
# Maximum compile jobs = BB_NUMBER_THREADS x the PARALLEL_MAKE -j value.
BB_NUMBER_THREADS = "4"
# -l 12: make starts no new job while the load average is above 12.
PARALLEL_MAKE = "-j 4 -l 12"
# Lowest CPU priority and lowest best-effort disk priority for build tasks.
BB_TASK_NICE_LEVEL = "19"
BB_TASK_IONICE_LEVEL = "2.7"
# Start no new task while processes stall on memory more than 2% of the time
# (/proc/pressure/memory, microseconds per second).
BB_PRESSURE_MAX_MEMORY = "20000"

USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

# CONF_VERSION changes when build/conf/local.conf changes incompatibly.
CONF_VERSION = "2"
